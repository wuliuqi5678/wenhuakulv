# 复制本文件为 .env，填入自己的 DeepSeek Key 后重启服务
# 注意：.env 只放在本机，不要提交或截图分享
DEEPSEEK_API_KEY=sk-在这里填你的key

# 可选（一般不用改）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI 安全选项（可选）
# 非本机监听（HOST=0.0.0.0）时，AI 默认关闭；确需局域网使用再设 1
# AI_ALLOW_REMOTE=1
# 每日全站 AI 请求上限（默认 300，防止余额被刷）
# AI_DAILY_LIMIT=300
